{
  "name": "INCONTEC AI Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "incontec-ai",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1f6a1e1a-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://cusdjjbsvnbvspqzhkjd.supabase.co/rest/v1/vw_kpis",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $credentials.httpHeaderAuth.value }}" }
          ]
        },
        "options": {}
      },
      "id": "1f6a1e1a-0000-4000-8000-000000000002",
      "name": "Fetch KPIs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Supabase Service Role" }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://cusdjjbsvnbvspqzhkjd.supabase.co/rest/v1/vw_bancos",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "Descri_banco,saldo" },
            { "name": "order", "value": "saldo.desc" },
            { "name": "limit", "value": "5" }
          ]
        },
        "options": {}
      },
      "id": "1f6a1e1a-0000-4000-8000-000000000003",
      "name": "Fetch Top Bancos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Supabase Service Role" }
      }
    },
    {
      "parameters": {
        "jsCode": "const question = $('Webhook').first().json.body.question || '';\nconst kpis = $('Fetch KPIs').first().json[0] || {};\nconst bancos = $('Fetch Top Bancos').first().json || [];\n\nconst bancosText = bancos.map(b => `- ${b.Descri_banco}: R$ ${Math.round(b.saldo).toLocaleString('pt-BR')}`).join('\\n');\n\nconst context = `Você é o assistente financeiro da INCONTEC, uma construtora. Responda em português, de forma direta e objetiva (2-4 frases), usando SOMENTE os dados abaixo. Se a pergunta não puder ser respondida com esses dados, diga isso claramente em vez de inventar números.\n\nDados consolidados:\n- Saldo em bancos: R$ ${Math.round(kpis.saldo_bancos || 0).toLocaleString('pt-BR')}\n- Total vendido: R$ ${Math.round(kpis.valor_vendido || 0).toLocaleString('pt-BR')}\n- Total recebido: R$ ${Math.round(kpis.valor_recebido || 0).toLocaleString('pt-BR')}\n- Total a receber: R$ ${Math.round(kpis.total_receber || 0).toLocaleString('pt-BR')}\n- Total de vendas: ${kpis.total_vendas || 0}\n\nTop 5 bancos por saldo:\n${bancosText}\n\nPergunta do usuário: ${question}`;\n\nreturn [{ json: { prompt: context, question } }];"
      },
      "id": "1f6a1e1a-0000-4000-8000-000000000004",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"claude-sonnet-4-5\", max_tokens: 400, messages: [{ role: \"user\", content: $json.prompt }] }) }}",
        "options": {}
      },
      "id": "1f6a1e1a-0000-4000-8000-000000000005",
      "name": "Call Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Anthropic API Key" }
      }
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst answer = res?.content?.[0]?.text || 'Não consegui gerar uma resposta agora. Tente novamente.';\nreturn [{ json: { answer } }];"
      },
      "id": "1f6a1e1a-0000-4000-8000-000000000006",
      "name": "Extract Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "1f6a1e1a-0000-4000-8000-000000000007",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1320, 0]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Fetch KPIs", "type": "main", "index": 0 }]] },
    "Fetch KPIs": { "main": [[{ "node": "Fetch Top Bancos", "type": "main", "index": 0 }]] },
    "Fetch Top Bancos": { "main": [[{ "node": "Build Prompt", "type": "main", "index": 0 }]] },
    "Build Prompt": { "main": [[{ "node": "Call Claude", "type": "main", "index": 0 }]] },
    "Call Claude": { "main": [[{ "node": "Extract Answer", "type": "main", "index": 0 }]] },
    "Extract Answer": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
